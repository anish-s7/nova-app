# Supabase (hosted project — create at https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Sign-in is required whenever the two NEXT_PUBLIC_SUPABASE_* keys are set.
# Leave them empty to run the frontend on demo data with no sign-in.

# Demo persona password for scripts/seed-real-data.ts (12+ chars). Never commit it: the repo is
# public. Re-running the seed applies it to existing personas too.
SEED_DEMO_PASSWORD=

# Gemini
GEMINI_API_KEY=

# Private listening-history imports and personal discovery. Both stay off unless
# explicitly enabled server-side; none of these values are exposed to the browser.
LISTENING_ENABLED=false
DISCOVERY_ENABLED=false
LASTFM_API_KEY=
CRON_SECRET=

# MusicBrainz (no API key/account needed — just a real, reachable email for
# their required User-Agent contact info. Use a throwaway/alias address,
# not a personal one: this repo is public, and hardcoding it in source
# would get it scraped. An env var keeps it out of git entirely.)
MUSICBRAINZ_CONTACT_EMAIL=

# Spotify: not used by the app UI (development mode only admits allowlisted accounts). Optional.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# Google / Apple sign-in: only needed for the LOCAL Supabase CLI (supabase/config.toml).
# For the hosted project, paste these into Dashboard → Authentication → Providers instead.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
# Real data is used automatically whenever the NEXT_PUBLIC_SUPABASE_* keys are set.
# NEXT_PUBLIC_DATA_SOURCE=mock forces the demo world even with keys set.
NEXT_PUBLIC_DATA_SOURCE=
# Legacy: only matters without Supabase keys ("http" = real /api/galaxy).
NEXT_PUBLIC_GALAXY_SOURCE=
