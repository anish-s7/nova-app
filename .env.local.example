# Supabase (hosted project — create at https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini
GEMINI_API_KEY=

# MusicBrainz (no API key/account needed — just a real, reachable email for
# their required User-Agent contact info. Use a throwaway/alias address,
# not a personal one: this repo is public, and hardcoding it in source
# would get it scraped. An env var keeps it out of git entirely.)
MUSICBRAINZ_CONTACT_EMAIL=

# Spotify (dev-mode app, allowlist testers in the Spotify dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback
