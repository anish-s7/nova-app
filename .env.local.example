# Supabase (hosted project — create at https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Sign-in is required whenever the two NEXT_PUBLIC_SUPABASE_* keys are set.
# Leave them empty to run the frontend on demo data with no sign-in.

# Gemini
GEMINI_API_KEY=

# Spotify (dev-mode app, allowlist testers in the Spotify dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# Google / Apple sign-in: only needed for the LOCAL Supabase CLI (supabase/config.toml).
# For the hosted project, paste these into Dashboard → Authentication → Providers instead.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
